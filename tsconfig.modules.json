{
	"//": "app/modules のうち型検査を通せるファイルの一覧。app/ 全体はまだ型エラーが残るため、通るファイルから順に CI の型検査に載せる。既存モジュール(DroneModel/MapStyleManager 等)には別途の型負債があり本ファイルの対象外（改善計画 Phase 2-6/2-7 で解消予定）。未使用変数検査は ESLint が担うため無効化。",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Node",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noImplicitReturns": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"isolatedModules": true,
		"skipLibCheck": true,
		"useDefineForClassFields": true,
		"noEmit": true
	},
	"files": [
		"app/modules/elevation.ts",
		"app/modules/device-profile.ts",
		"app/modules/flight-plan-editor.ts",
		"app/modules/PlanPanel.ts",
		"app/modules/MobileHud.ts",
		"app/modules/safe-storage.ts",
		"app/modules/elevation.test.ts",
		"app/modules/device-profile.test.ts",
		"app/modules/flight-plan-editor.test.ts",
		"app/modules/PlanPanel.test.ts",
		"app/modules/MobileHud.test.ts",
		"app/modules/safe-storage.test.ts"
	]
}
